FUNCTION_BLOCK "HardwareOutput"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ComRotate : Bool;
      LampWork : Bool;
   END_VAR

BEGIN
    // ============================================
    // СОПРЯЖЕНИЕ С АППАРАТУРОЙ: ЗАПИСЬ ВЫХОДОВ
    // ============================================
    // Единственное место программы, где пишутся физические выходы.
    // DO_ComMotor — катушка пускателя двигателя конвейера;
    // DO_LampWork  — физическая лампа «работа» (если установлена).
    // Лампа панели оператора сюда не относится, она живёт в "Hmi_DB".
    // ============================================

    "DO_ComMotor" := #ComRotate;
    "DO_LampWork" := #LampWork;
END_FUNCTION_BLOCK
