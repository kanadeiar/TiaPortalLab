FUNCTION_BLOCK "HMIInterface"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      BeltRun : Bool;
      BeltFault : Bool;
   END_VAR

BEGIN
    // ============================================
    // СОПРЯЖЕНИЕ С ПАНЕЛЬЮ ОПЕРАТОРА (ЧМИ)
    // ============================================
    // Лампы и кнопки панели не занимают физические выходы ПЛК:
    // они хранятся в global-DB "Hmi_DB" и не имеют адреса I/O.
    // Кнопки «Стоп» и аварийного останова добавляются сюда,
    // когда появятся в требованиях задания.
    // ============================================

    "Hmi_DB".LampWork := #BeltRun;
    "Hmi_DB".LampFault := #BeltFault;
END_FUNCTION_BLOCK
