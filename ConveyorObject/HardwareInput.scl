FUNCTION_BLOCK "HardwareInput"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_OUTPUT 
      BoxOnStart : Bool;
      BoxOnEnd : Bool;
   END_VAR

BEGIN
    // ============================================
    // СОПРЯЖЕНИЕ С АППАРАТУРОЙ: ЧТЕНИЕ ВХОДОВ
    // ============================================
    // Единственное место программы, где читаются физические входы.
    // Датчики нормально закрытые (НЗ / NC): логическая 1 на входе
    // означает «коробки нет», поэтому сигналы инвертируются до
    // смысла «коробка обнаружена» на начале и на конце ленты.
    // Обрыв провода или потеря питания датчика неотличимы от
    // присутствия коробки: на конечном датчике это даёт останов,
    // на стартовом — ложный пуск. Диагностика в задаче не предусмотрена.
    // ============================================

    #BoxOnStart := NOT "DI_SensorA";
    #BoxOnEnd := NOT "DI_SensorB";
END_FUNCTION_BLOCK
