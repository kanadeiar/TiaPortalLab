FUNCTION_BLOCK "HardwareInput"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_OUTPUT 
      BoxOnStart : Bool;
      BoxOnEnd : Bool;
   END_VAR

BEGIN
    // ============================================
    // СОПРЯЖЕНИЕ С АППАРАТУРОЙ: ЧТЕНИЕ ВХОДОВ
    // ============================================
    // Единственное место программы, где читаются физические входы.
    // Датчики нормально закрытые (НЗ / NC): логическая 1 на входе
    // означает «коробки нет», поэтому сигнал инвертируется до
    // смысла «коробка обнаружена».
    // Обрыв провода или потеря питания датчика дают тот же FALSE,
    // что и коробка, — в этой задаче диагностика не предусмотрена.
    // ============================================

    #BoxOnStart := NOT "DI_SensorA";
    #BoxOnEnd := NOT "DI_SensorB";
END_FUNCTION_BLOCK
